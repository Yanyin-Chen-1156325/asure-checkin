# These non-sensitive values are validated by the server foundation.
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Pacific/Auckland

# Authentication secrets. Never expose these as NEXT_PUBLIC_*.
OWNER_USERNAME=owner
OWNER_PASSWORD_HASH=
STAFF_USERNAME=staff
STAFF_PASSWORD_HASH=
# At least 32 cryptographically random bytes. Rotating it invalidates every session.
AUTH_SECRET=
# Bounded to 15 minutes-12 hours; defaults to 8 hours.
AUTH_SESSION_TTL_SECONDS=28800

# Notion integration configuration.
NOTION_TOKEN=
# Arrivals database and its data source.
NOTION_ARRIVALS_DATABASE_ID=
# Required by the 2026-03-11 API for schema retrieval and arrival queries.
NOTION_ARRIVALS_DATA_SOURCE_ID=
NOTION_TEMPLATES_DATABASE_ID=
NOTION_TEMPLATES_DATA_SOURCE_ID=
NOTION_SIGNING_OPERATIONS_DATABASE_ID=
